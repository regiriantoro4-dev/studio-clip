# ==== Studio Clip (auto-clipper) ====
# Repo ini WAJIB privat. API key hanya ada di backend/data/settings.json (tidak ikut).

# --- Rahasia ---
.env
.env.*
!.env.example
**/settings.json
!backend/settings.example.json
.claude/settings.local.json

# --- Data app ---
# IKUT (pengaturan & aset, supaya perangkat baru sama persis): assets/ (font, frame,
#   ornamen, sfx, musik), studio/ (desain & preset Frame Studio), aturan acak gaya.
# TIDAK IKUT: settings.json (API key), projects/ (hasil produksi), bumpers/ (cache,
#   dibuat ulang otomatis), factory/ (antrean job), horror_drafts/ & horror_history.json.
backend/data/*
!backend/data/assets/
!backend/data/studio/
!backend/data/acak_gaya.json
!backend/data/acak_gaya_riwayat.json
!backend/data/suara_profil.json

# --- Video / audio hasil ---
Siap Upload/
# produksi/: video hasil & cadangan skrip tidak ikut; naskah + bible cerita ikut
tools/animasi-3d/produksi/**
!tools/animasi-3d/produksi/*/
tools/animasi-3d/produksi/*/video*/
tools/animasi-3d/produksi/__pycache__/
!tools/animasi-3d/produksi/*/naskah*.json
!tools/animasi-3d/produksi/*/bible.json
!tools/animasi-3d/produksi/*/bible.md
tools/animasi-3d/hasil*/
tools/animasi-3d/_llm_terakhir.txt
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.wav
*.m4a

# --- Lingkungan (dibuat ulang oleh setup.bat / setup.sh) ---
.venv/
.venv-*/
venv/
node_modules/
frontend/dist/
__pycache__/
*.pyc
.pytest_cache/

# --- Cadangan lama (riwayat git sudah jadi cadangan) ---
backup-*/
frontend/src.backup-*/
**/cadangan-*/

# --- Alat bantu lokal & sampah ---
.claude-flow/
.swarm/
.superpowers/
*.log
.DS_Store
Thumbs.db
/25000
/{

# Aset app (musik/sfx) tetap ikut walau ada aturan *.mp3/*.wav di atas
!backend/data/assets/**
